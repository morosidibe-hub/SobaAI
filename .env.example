# Copiez ce fichier en `.env` puis renseignez les valeurs.

# --- IA (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=16000

# --- Base de données ---
POSTGRES_USER=soba
POSTGRES_PASSWORD=soba
POSTGRES_DB=sobaai
DATABASE_URL=postgresql+asyncpg://soba:soba@localhost:5432/sobaai

# --- Backend ---
CORS_ORIGINS=["http://localhost:5173"]
